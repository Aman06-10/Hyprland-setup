monitor=,preferred,auto,1.33

$mainMod = SUPER

$terminal = kitty
$menu = wofi --show drun


# =================
# INPUT
# =================

input {
    kb_layout = us
    follow_mouse = 1

    touchpad {
        natural_scroll = true
    }
}


# =================
# LOOK
# =================

general {
    gaps_in = 6
    gaps_out = 12
    border_size = 2

    layout = dwindle
}


decoration {
    rounding = 10

    blur {
        enabled = true
        size = 6
        passes = 3
    }
}


animations {
    enabled = true

    bezier = smooth,0.25,0.1,0.25,1

    animation = windows,1,4,smooth
    animation = fade,1,4,smooth
    animation = workspaces,1,4,smooth
}


dwindle {
    preserve_split = true
}



# =================
# APPS
# =================

bind = $mainMod, RETURN, exec, $terminal

bind = $mainMod, D, exec, $menu

# window switcher like your rofi tab
bind = $mainMod, TAB, exec, wofi --show window


# =================
# WINDOW CONTROL
# =================

# close
bind = $mainMod SHIFT, Q, killactive


# fullscreen
bind = $mainMod, F, fullscreen


# floating toggle
bind = $mainMod SHIFT, SPACE, togglefloating


# focus (same i3 style)
bind = $mainMod, J, movefocus, l
bind = $mainMod, K, movefocus, d
bind = $mainMod, L, movefocus, u
bind = $mainMod, SEMICOLON, movefocus, r


# move windows
bind = $mainMod SHIFT, J, movewindow, l
bind = $mainMod SHIFT, K, movewindow, d
bind = $mainMod SHIFT, L, movewindow, u
bind = $mainMod SHIFT, SEMICOLON, movewindow, r



# =================
# WORKSPACES
# =================

bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10


# move window to workspace

bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5



# =================
# MEDIA KEYS
# =================

bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

bindel = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle


# brightness

bindel = , XF86MonBrightnessUp, exec, brightnessctl set +5%

bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-



# =================
# SHORTCUT APPS
# =================

bind = $mainMod SHIFT, M, exec, brave-browser --app=https://music.youtube.com

bind = $mainMod SHIFT, W, exec, google-chrome --app=https://web.whatsapp.com


# =================
# SCREENSHOT
# =================

bind = , PRINT, exec, grim ~/Pictures/screenshot.png


# =================
# STARTUP
# =================

exec-once = dunst	
exec-once = waybar
